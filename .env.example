DATABASE_URL=postgresql://user:pass@localhost:5432/dailystand
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-generated-secret

# Comma-separated allowlists
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
API_ALLOWED_ORIGINS=http://localhost:3000
RESET_PASSWORD_TOKEN_EXPIRES_IN=3600
RESEND_API_KEY=
RESEND_FROM_EMAIL=DailyStand <no-reply@your-domain.com>
EMAIL_DIGEST_WORKFLOW_SECRET=replace-with-random-secret

# Optional Sentry (TanStack Start React)
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
VITE_SENTRY_SEND_DEFAULT_PII=false
VITE_SENTRY_ENABLE_IN_DEV=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
