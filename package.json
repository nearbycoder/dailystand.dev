{
  "name": "dailystand",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "build": "vite build && cp instrument.server.mjs .output/server/instrument.server.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test:unit && bun run test:e2e",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "workflow:email-digests": "tsx src/scripts/run-email-digests.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.27",
    "@better-auth/stripe": "^1.7.27",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@posthog/react": "^1.11.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/tanstackstart-react": "^11.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/router-plugin": "^1.169.0",
    "@trpc/client": "^11.29.6",
    "@trpc/server": "^11.29.5",
    "@trpc/tanstack-react-query": "^11.29.5",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.23.1",
    "posthog-node": "^6.0.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "satori": "^0.63.2",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "superjson": "^2.2.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2"
  }
}
